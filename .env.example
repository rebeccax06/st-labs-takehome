# Read directly from the environment; .env files are not loaded automatically.
CMDB_DATABASE_URL=sqlite:///cmdb.db
CMDB_SQLITE_BUSY_TIMEOUT_MS=3000
CMDB_ORGANIZATION_ID=example-corp
CMDB_SOURCE_CONFIG_PATH=examples/sample_sources.json

# Optional: environment keys override token.txt. Never commit real credentials.
# CMDB_OPENROUTER_API_KEY=
CMDB_OPENROUTER_TOKEN_PATH=token.txt
CMDB_OPENROUTER_MODEL=openai/gpt-4o-mini
CMDB_OPENROUTER_TIMEOUT_SECONDS=30
CMDB_OPENROUTER_MAX_TOKENS=4096
